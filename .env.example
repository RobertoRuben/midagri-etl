# Copiar a .env y completar. Variables de la API (prefijo MIDAGRI_).
# =====================================================================
# =====================================================================
MIDAGRI_ENVIRONMENT=qas
MIDAGRI_LOG_LEVEL=INFO
MIDAGRI_API_PUBLIC_URL=http://localhost:8000

# Autenticación MVP: una sola X-API-Key (D24)
MIDAGRI_API_KEY=<generar: python -c "import secrets;print(secrets.token_urlsafe(32))">

# SQL Server: tablas de negocio (QAS = BDFarmex_Agri)
MIDAGRI_MSSQL_HOST=<host>
MIDAGRI_MSSQL_PORT=1433
MIDAGRI_MSSQL_DATABASE=<BDFarmex_Agri en QAS | BDFARMEX en producción>
MIDAGRI_MSSQL_USERNAME=<usuario>
MIDAGRI_MSSQL_PASSWORD=<contraseña>
MIDAGRI_MSSQL_DRIVER="ODBC Driver 17 for SQL Server"
MIDAGRI_MSSQL_POOL_SIZE=5
MIDAGRI_MSSQL_MAX_OVERFLOW=5

# PostgreSQL: tablas propias de la API (etl_run, etl_run_event, price_load, mail_*)
MIDAGRI_PG_HOST=<host>
MIDAGRI_PG_PORT=5432
MIDAGRI_PG_DATABASE=midagri_qas
MIDAGRI_PG_USERNAME=<usuario>
MIDAGRI_PG_PASSWORD=<contraseña>
MIDAGRI_PG_POOL_SIZE=5
MIDAGRI_PG_MAX_OVERFLOW=10
MIDAGRI_DATABASE_DEBUG=false

# Portal SISAP
MIDAGRI_SISAP_BASE_URL=http://sistemas.midagri.gob.pe/sisap/portal2
MIDAGRI_SISAP_CONCURRENCY=4
MIDAGRI_SISAP_TIMEOUT_SECONDS=120
MIDAGRI_SISAP_RETRIES=3
MIDAGRI_ETL_DEFAULT_WINDOW_DAYS=5
MIDAGRI_ETL_EXCLUDED_MARKETS=15010106
# Alta automática de faltantes en BM_Catalog / IT_Multivalor al final de cada ejecución (D36). Primero en QAS.
MIDAGRI_CATALOG_AUTO_REGISTER=false

# Correo (D37): Gmail por SMTP con contraseña de aplicación (requiere verificación en 2 pasos).
# Destinatarios en mail_recipient (D25). MIDAGRI_MAIL_FROM es opcional: por defecto, la cuenta.
MIDAGRI_MAIL_PROVIDER=gmail
MIDAGRI_MAIL_USERNAME=<cuenta de Gmail remitente>
MIDAGRI_MAIL_PASSWORD=<pendiente: contraseña de aplicación>
# MIDAGRI_MAIL_SMTP_HOST=smtp.gmail.com
# MIDAGRI_MAIL_SMTP_PORT=587
# Alternativa, Microsoft 365 vía Graph (D35): MIDAGRI_MAIL_PROVIDER=graph y
# MIDAGRI_MAIL_TENANT_ID, MIDAGRI_MAIL_CLIENT_ID, MIDAGRI_MAIL_CLIENT_SECRET, MIDAGRI_MAIL_FROM
MIDAGRI_MAIL_ENABLED=false
